{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.kube/**)",
      "Read(__HOME__/.config/drydock/**)",
      "Read(//**/.docker/config.json)",
      "Read(//**/.claude/.credentials.json)",
      "Read(//**/.claude-container*/.credentials.json)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/.aws/**)",
      "Edit(//**/.gnupg/**)",
      "Edit(//**/.kube/**)",
      "Edit(__HOME__/.config/drydock/**)",
      "Edit(//**/.docker/config.json)",
      "Edit(//**/.claude/.credentials.json)",
      "Edit(//**/.claude-container*/.credentials.json)",
      "Write(//**/.ssh/**)",
      "Write(//**/.aws/**)",
      "Write(//**/.gnupg/**)",
      "Write(//**/.kube/**)",
      "Write(__HOME__/.config/drydock/**)",
      "Write(//**/.docker/config.json)",
      "Write(//**/.claude/.credentials.json)",
      "Write(//**/.claude-container*/.credentials.json)",
      "Bash(cat *__HOME__/.config/drydock/keys/*)",
      "Bash(less *__HOME__/.config/drydock/keys/*)",
      "Bash(more *__HOME__/.config/drydock/keys/*)",
      "Bash(head *__HOME__/.config/drydock/keys/*)",
      "Bash(tail *__HOME__/.config/drydock/keys/*)",
      "Bash(od *__HOME__/.config/drydock/keys/*)",
      "Bash(xxd *__HOME__/.config/drydock/keys/*)",
      "Bash(strings *__HOME__/.config/drydock/keys/*)"
    ]
  }
}
