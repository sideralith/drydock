{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.kube/**)",
      "Read(__HOME__/.config/drydock/**)",
      "Read(//**/.docker/config.json)",
      "Read(//**/.claude/.credentials.json)",
      "Read(//**/.claude-container*/.credentials.json)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/.aws/**)",
      "Edit(//**/.gnupg/**)",
      "Edit(//**/.kube/**)",
      "Edit(__HOME__/.config/drydock/**)",
      "Edit(//**/.docker/config.json)",
      "Edit(//**/.claude/.credentials.json)",
      "Edit(//**/.claude-container*/.credentials.json)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.production)",
      "Edit(//**/.env.development)",
      "Edit(//**/.env.test)",
      "Edit(//**/.env.staging)",
      "Bash(cat *__HOME__/.config/drydock/keys/*)",
      "Bash(less *__HOME__/.config/drydock/keys/*)",
      "Bash(more *__HOME__/.config/drydock/keys/*)",
      "Bash(head *__HOME__/.config/drydock/keys/*)",
      "Bash(tail *__HOME__/.config/drydock/keys/*)",
      "Bash(od *__HOME__/.config/drydock/keys/*)",
      "Bash(xxd *__HOME__/.config/drydock/keys/*)",
      "Bash(strings *__HOME__/.config/drydock/keys/*)",
      "Bash(bat *__HOME__/.config/drydock/keys/*)",
      "Bash(rg *__HOME__/.config/drydock/keys/*)",
      "Bash(nl *__HOME__/.config/drydock/keys/*)",
      "Bash(tac *__HOME__/.config/drydock/keys/*)"
    ]
  }
}
