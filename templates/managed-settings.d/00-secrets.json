{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(__HOME__/.ssh/**)",
      "Read(__HOME__/.aws/**)",
      "Read(__HOME__/.gnupg/**)",
      "Read(__HOME__/.kube/**)",
      "Read(__HOME__/.config/drydock/**)",
      "Read(__HOME__/.docker/config.json)",
      "Read(__HOME__/.claude/.credentials.json)",
      "Read(__HOME__/.claude-container/.credentials.json)",
      "Edit(__HOME__/.ssh/**)",
      "Edit(__HOME__/.aws/**)",
      "Edit(__HOME__/.gnupg/**)",
      "Edit(__HOME__/.kube/**)",
      "Edit(__HOME__/.config/drydock/**)",
      "Write(__HOME__/.ssh/**)",
      "Write(__HOME__/.aws/**)",
      "Write(__HOME__/.gnupg/**)",
      "Write(__HOME__/.kube/**)",
      "Write(__HOME__/.config/drydock/**)"
    ]
  }
}
