{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Baseline drydock denies — created by `drydock init` (per-project). __HOME__ is substituted with $HOME at init time. Extend per-project as needed; do NOT remove the secret-protection or git-safety blocks. ~/.config/drydock/ holds drydock's optional deploy key + sandbox GPG key — off-limits to the agent's file tools (git/ssh/gpg subprocesses still use them).",
  "permissions": {
    "deny": [
      "Read(__HOME__/.ssh/**)",
      "Read(__HOME__/.aws/**)",
      "Read(__HOME__/.gnupg/**)",
      "Read(__HOME__/.kube/**)",
      "Read(__HOME__/.config/drydock/**)",
      "Read(__HOME__/.docker/config.json)",
      "Read(__HOME__/.claude/.credentials.json)",
      "Read(__HOME__/.claude-container/.credentials.json)",
      "Edit(__HOME__/.ssh/**)",
      "Edit(__HOME__/.aws/**)",
      "Edit(__HOME__/.gnupg/**)",
      "Edit(__HOME__/.kube/**)",
      "Edit(__HOME__/.config/drydock/**)",
      "Write(__HOME__/.ssh/**)",
      "Write(__HOME__/.aws/**)",
      "Write(__HOME__/.gnupg/**)",
      "Write(__HOME__/.kube/**)",
      "Write(__HOME__/.config/drydock/**)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin :*)",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",
      "Bash(git branch -D dev)",
      "Bash(git branch -d main)",
      "Bash(git branch -d master)",
      "Bash(git branch -d dev)"
    ]
  }
}
