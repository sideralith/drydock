#!/usr/bin/env bash
# drydock — containerized Claude Code sandbox CLI
#
# Multi-project, single-image, defense-in-depth container for Claude Code.
# Repo: ~/drydock/  (consider sideralith/drydock when sharing publicly)
#
# Usage:
#   drydock                        # default: launch claude in current dir's project
#   drydock run [DIR] [-- ARGS]    # explicit run; ARGS after -- go to claude
#   drydock shell [DIR] [-- CMD]   # bash in container at DIR; -- CMD runs CMD instead
#   drydock -- [ARGS]              # shorthand: run claude in cwd with ARGS
#   drydock build                  # (re)build the image
#   drydock sync                   # ~/.claude/ → ~/.claude-container/
#   drydock status                 # short health
#   drydock doctor                 # detailed diagnostics
#   drydock version                # show version

set -euo pipefail

# ── DRYDOCK_HOME bootstrap ─────────────────────────────────────────────────────
# Uses ${BASH_SOURCE[0]} (not $0) so this file can be sourced by tests without
# spawning a subprocess. Follows symlinks to the real script location.
# Must stay inline — cannot source lib/paths.sh until DRYDOCK_HOME is known.
_dh_src="${BASH_SOURCE[0]}"
while [ -L "$_dh_src" ]; do
	_dh_dir="$(cd -P "$(dirname "$_dh_src")" >/dev/null 2>&1 && pwd)"
	_dh_src="$(readlink "$_dh_src")"
	[[ "$_dh_src" != /* ]] && _dh_src="$_dh_dir/$_dh_src"
done
DRYDOCK_HOME="${DRYDOCK_HOME:-$(cd -P "$(dirname "$_dh_src")/.." >/dev/null 2>&1 && pwd)}"
unset _dh_src _dh_dir

# ── Library modules ───────────────────────────────────────────────────────────
# shellcheck source=../lib/common.sh
source "$DRYDOCK_HOME/lib/common.sh"
# shellcheck source=../lib/paths.sh
source "$DRYDOCK_HOME/lib/paths.sh"
# shellcheck source=../lib/compose.sh
source "$DRYDOCK_HOME/lib/compose.sh"
# shellcheck source=../lib/sibling_ssh.sh
source "$DRYDOCK_HOME/lib/sibling_ssh.sh"
# shellcheck source=../lib/commands.sh
source "$DRYDOCK_HOME/lib/commands.sh"

# ── Dispatch ──────────────────────────────────────────────────────────────────

main() {
	local cmd="${1:-run}"
	[ $# -gt 0 ] && shift

	# Reap orphan overlay files left by previous drydock invocations that
	# `exec`d into docker compose (so their EXIT trap did not fire).
	# Skip files whose owning PID is still alive (concurrent invocation).
	# Iterates both overlay glob patterns so new overlay types need only one
	# extra string here (ADR-4 / D5).
	local _stale _pid _glob
	for _glob in "drydock-submounts-*.yml" "drydock-links-*.yml"; do
		for _stale in "${TMPDIR:-/tmp}"/$_glob; do
			[ -e "$_stale" ] || continue
			# Multi-user /tmp: the glob also matches OTHER users' overlays.
			# Skip anything we do not own — kill -0 on a foreign LIVE pid
			# fails with EPERM (misread as dead), and rm on a foreign
			# sticky-/tmp file fails anyway. Reap only our own orphans.
			[ -O "$_stale" ] || continue
			_pid="${_stale##*-}"
			_pid="${_pid%.yml}"
			case "$_pid" in
			'' | *[!0-9]*)
				# Guard rm: an unremovable file (read-only TMPDIR, perms
				# race) must not kill dispatch under set -e.
				rm -f "$_stale" 2>/dev/null || true
				continue
				;;
			esac
			kill -0 "$_pid" 2>/dev/null || rm -f "$_stale" 2>/dev/null || true
		done
	done
	unset _stale _pid _glob

	# Submount overlay: PID-namespaced temp file cleaned up on EXIT.
	# MUST be inside main() (post source-guard): bats files source bin/drydock
	# to test functions, and a top-level trap would fire at test cleanup.
	# NOTE: shell + nested-run paths still use `exec docker compose run` —
	# `exec` replaces this bash process and the trap NEVER fires for those paths.
	# run/new/attach paths now use _run_claude_lifecycle (child, not exec), so
	# this EXIT trap fires correctly on those paths. The orphan-reap loop above
	# is kept as defense-in-depth for the still-exec'd shell/nested paths.
	SUBMOUNT_OVERLAY="${TMPDIR:-/tmp}/drydock-submounts-$$.yml"
	export SUBMOUNT_OVERLAY
	# Links overlay: same lifecycle as SUBMOUNT_OVERLAY.
	LINKS_OVERLAY="${TMPDIR:-/tmp}/drydock-links-$$.yml"
	export LINKS_OVERLAY
	trap 'rm -f "${SUBMOUNT_OVERLAY:-}" "${LINKS_OVERLAY:-}"' EXIT

	case "$cmd" in
	run) cmd_run "$@" ;;
	shell) cmd_shell "$@" ;;
	--) cmd_run -- "$@" ;;
	new) cmd_new "$@" ;;
	attach) cmd_attach "$@" ;;
	list) cmd_list "$@" ;;
	stop) cmd_stop "$@" ;;
	setup) cmd_setup "$@" ;;
	setup-token) cmd_setup_token "$@" ;;
	revoke-token) cmd_revoke_token "$@" ;;
	build) cmd_build "$@" ;;
	sync) cmd_sync "$@" ;;
	status) cmd_status "$@" ;;
	doctor) cmd_doctor "$@" ;;
	link) cmd_link "$@" ;;
	unlink) cmd_unlink "$@" ;;
	links) cmd_links "$@" ;;
	dood) cmd_dood "$@" ;;
	contain) cmd_contain "$@" ;;
	default) cmd_default "$@" ;;
	version | --version | -v) echo "drydock $DRYDOCK_VERSION" ;;
	help | --help | -h) usage ;;
	*) err "unknown command: $cmd — run: drydock help" ;;
	esac
}

# Source-guard: only run main() when executed directly, not when sourced.
# Use the if-form (not '... && main "$@" || true'): with the && / || form, main
# would run in a context where set -e is ignored, so a failure in cmd_build /
# cmd_sync / cmd_setup would be silently swallowed (the command returns 0). The
# if-form keeps set -e active inside main(); when sourced, the false condition
# makes the statement return 0, so 'source bin/drydock' stays safe under set -e.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
