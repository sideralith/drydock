# OS junk
.DS_Store
Thumbs.db

# Editor swap files
*.swp
*~

# Local overrides (advanced users may have a local .env)
.env
.env.local

# Test/scratch (anything you don't want to commit)
/scratch/
/tmp/

# SR-9 integration test scratch — hermetic fake-HOME tree built under the
# project root (see test/integration/test_projects_submount.sh). Always
# rm -rf'd by the test itself; ignored so a crashed run never gets committed.
/.inttest-tmp/

# Agent Teams / SDD local artifacts
/.atl/

# Per-developer drydock init output (host-path-substituted .claude/settings.json).
# The canonical template lives at templates/default-settings.json.
.claude/

# Per-session AI handoff briefings — engram is the source of truth; this is
# only a path-discoverable mirror for the next session and must not be versioned.
/.handoff/

# Engram memory chunks — per-developer working memory, not a publication
# format; never versioned (chunks can embed private project context).
/.engram/

# Social media post drafts — local-only working notes, not part of the project
/.social/
